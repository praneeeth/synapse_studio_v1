# NOTE: this file previously contained the literal text of the shell heredoc
# used to create it (`cat > .gitignore << 'EOF'` ... `EOF`), which meant every
# rule below was being read as a filename pattern and nothing was ignored.

# ---- Python ----
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.so
*.egg-info/
.venv/
venv/
backend/.venv/
backend/venv/
.pytest_cache/
.ruff_cache/

# ---- Node / JS ----
node_modules/
dist/
dist-ssr/
build/
.cache/
*.local
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ---- Environment / secrets ----
.env
.env.*
!.env.example
*.pem

# ---- Runtime data (regenerated by the app; must not be committed) ----
backend/chroma_db/
backend/data/
backend/logs/

# ---- Model caches ----
.cache/huggingface/
*.onnx

# ---- OS / editor ----
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
